# ─────────────────────────────────────────────────────────────
# 梦之城综合教学平台 · 环境变量样例
# 复制为 .env 后按需修改。开发环境全部有本地兜底，不填也能跑。
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── 域名与跨域 ───────────────────────────────────────────
# 生产必须填：允许访问的域名，逗号分隔。
# 留空 = 允许任何来源（开发方便，生产危险）。
CORS_ORIGINS=
# 生产由后端直接托管打包好的前端（auto=打包产物存在就托管）
SERVE_WEB=auto

# ── 数据库 ────────────────────────────────────────────────
# pglite = 零安装的 WASM Postgres（开发默认，数据落在 var/pgdata）
# pg     = 真实 PostgreSQL（生产）
DATABASE_DRIVER=pglite
# DATABASE_URL=postgres://user:pass@host:5432/dreamcity
# PGLITE_DATA_DIR=./var/pgdata

# ── 缓存（课堂码 / 会话 / 限流）────────────────────────────
# 不填则使用进程内 Map + TTL 兜底（单机单实例足够 V1）
# REDIS_URL=redis://127.0.0.1:6379

# ── 令牌 ─────────────────────────────────────────────────
# 生产必须设置；开发不设置会用固定开发密钥并打印警告
# JWT_SECRET=please-change-me-in-production
TOKEN_TTL_MINUTES=720

# ── 短信（家长登录验证码）─────────────────────────────────
# driver = log 时验证码打印到服务端控制台，不发真实短信
SMS_DRIVER=log
# SMS_APP_ID=
# SMS_SECRET_ID=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=

# ── 对象存储（课件 / 作品 / 素材）─────────────────────────
# driver = local 时落盘到 var/objects
OBJECT_STORE_DRIVER=local
# OBJECT_STORE_DIR=./var/objects
# S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# S3_REGION=ap-guangzhou
# S3_BUCKET=dreamcity-1250000000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# ── 后台占位账号（讲师 / 运营 / 管理员）──────────────────────
# 讲师后台走隐藏 URL（/console）+ 账号密码双闸。
# 这里配的是「保底能进后台的那个账号」，正式讲师账号用
#   npm run create:teacher --email … --name …
# 建（邮箱 + 密码，登录时邮箱也能当账号用）。
#
# ⚠️ 默认口令是开发占位值。正式使用前务必改：
#   ADMIN_PASSWORD=<自己的口令>
# 要彻底关掉这个账号（只留 create-teacher 建的正式账号）：
#   ADMIN_ENABLED=false
ADMIN_ENABLED=true
ADMIN_USER=admin
ADMIN_PASSWORD=123456

# ── 端口 ─────────────────────────────────────────────────
SERVER_PORT=8787
WEB_PORT=5173
