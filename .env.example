# ─────────────────────────────────────────────────────────────
# 梦之城综合教学平台 · 环境变量样例
# 复制为 .env 后按需修改。开发环境全部有本地兜底，不填也能跑。
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── 域名与跨域 ───────────────────────────────────────────
# 生产必须填：允许访问的域名，逗号分隔。
# 留空 = 允许任何来源（开发方便，生产危险）。
CORS_ORIGINS=
# 生产由后端直接托管打包好的前端（auto=打包产物存在就托管）
SERVE_WEB=auto

# ── 数据库 ────────────────────────────────────────────────
# pglite = 零安装的 WASM Postgres（开发默认，数据落在 var/pgdata）
# pg     = 真实 PostgreSQL（生产）
DATABASE_DRIVER=pglite
# DATABASE_URL=postgres://user:pass@host:5432/dreamcity
# PGLITE_DATA_DIR=./var/pgdata

# ── 缓存（课堂码 / 会话 / 限流）────────────────────────────
# 不填则使用进程内 Map + TTL 兜底（单机单实例足够 V1）
# REDIS_URL=redis://127.0.0.1:6379

# ── 令牌 ─────────────────────────────────────────────────
# 生产必须设置；开发不设置会用固定开发密钥并打印警告
# JWT_SECRET=please-change-me-in-production
TOKEN_TTL_MINUTES=720

# ── 短信（家长登录验证码）─────────────────────────────────
# driver = log 时验证码打印到服务端控制台，不发真实短信
# driver = tencent 时走腾讯云真实发送
SMS_DRIVER=log
# 短信应用 ID（腾讯云 → 短信 → 应用管理）
# 本项目：1401230486（应用「梦之城综合门户」）
# SMS_APP_ID=1401230486
# 子账号密钥（别用主账号密钥）：腾讯云 → 访问管理 → API 密钥管理
# 本项目：子用户 PC005，权限 QcloudSMSFullAccess
# ⚠ 密钥值不写在这里 —— 只放服务器 .env，仓库里不存
# SMS_SECRET_ID=
# SMS_SECRET_KEY=
# 签名内容（不是签名 ID）：腾讯云 → 短信 → 签名管理
# 本项目：深圳领航梦之城科技
# ⚠ 签名类型必须与模板类型一致：
#    验证码签名配验证码短信模板，通用签名配通知短信模板，营销签名配推广短信模板
# SMS_SIGN_NAME=深圳领航梦之城科技
# 模板 ID：腾讯云 → 短信 → 模板管理
# 本项目：2761496（类型：验证码短信）
# SMS_TEMPLATE_CODE=2761496
#
# 模板参数个数必须与模板变量个数一致：
#   本项目的模板是「{1}为您的登录验证码，请于{2}分钟内填写…」→ 2 个变量
#   验证码类模板若只有一个 {1}（有效期写死在文案里）→ 改成 1
SMS_TEMPLATE_PARAM_COUNT=2
# 验证码有效期（分钟）。模板文案里写的 {2} 就是这个值
SMS_CODE_TTL_MINUTES=5
# 限流：一个教室的家长共用同一个公网 IP，IP 额度要够一整个学校用
SMS_IP_HOURLY_LIMIT=300
SMS_PHONE_HOURLY_LIMIT=5

# ── 对象存储（课件 / 作品 / 素材）─────────────────────────
# driver = local 时落盘到 var/objects
OBJECT_STORE_DRIVER=local
# OBJECT_STORE_DIR=./var/objects
# S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# S3_REGION=ap-guangzhou
# S3_BUCKET=dreamcity-1250000000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# ── 后台占位账号（讲师 / 运营 / 管理员）──────────────────────
# 讲师后台走隐藏 URL（/console）+ 账号密码双闸。
# 这里配的是「保底能进后台的那个账号」，正式讲师账号用
#   npm run create:teacher --email … --name …
# 建（邮箱 + 密码，登录时邮箱也能当账号用）。
#
# ⚠️ 默认口令是开发占位值。正式使用前务必改：
#   ADMIN_PASSWORD=<自己的口令>
# 要彻底关掉这个账号（只留 create-teacher 建的正式账号）：
#   ADMIN_ENABLED=false
ADMIN_ENABLED=true
ADMIN_USER=admin
ADMIN_PASSWORD=123456

# ── 端口 ─────────────────────────────────────────────────
SERVER_PORT=8787
WEB_PORT=5173
